---
import Base from '../layouts/Base.astro';
import home from '../data/home.json';
---

<Base chrome={false} descrizione="Alessio Grassi — scrittura e fotografia.">
  <main class="threshold">
    <img class="threshold__img" src={home.copertina} alt="Fotografia in bianco e nero di Alessio Grassi" />
    <div class="threshold__scrim" aria-hidden="true"></div>
    <div class="threshold__foot">
      <h1 class="threshold__name">Alessio Grassi</h1>
      <hr class="threshold__rule" />
      <nav class="doors" aria-label="Sezioni principali">
        <a href="/scrittura">Scrittura</a>
        <span class="doors__sep" aria-hidden="true">·</span>
        <a href="/fotografia">Fotografia</a>
      </nav>
    </div>
  </main>
</Base>
